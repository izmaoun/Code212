# ═══════════════════════════════════════════════════════════════
# CODE212 - .gitignore
# ═══════════════════════════════════════════════════════════════

# ─── Secrets / Environnement ───────────────────────────────────
.env
.env.local
.env.production
.env.staging
!.env.example                    # Autoriser .env.example

# ─── Maven ─────────────────────────────────────────────────────
**/target/
**/pom.xml.tag
**/pom.xml.releaseBackup
**/pom.xml.versionsBackup
**/pom.xml.next
**/release.properties
**/dependency-reduced-pom.xml
**/buildNumber.properties
**/.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ─── Gradle (si utilisé) ───────────────────────────────────────
**/.gradle/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# ─── IDE : IntelliJ IDEA ───────────────────────────────────────
**/.idea/
**/*.iml
**/*.ipr
**/*.iws
**/out/
*.iws

# ─── IDE : Eclipse ─────────────────────────────────────────────
**/.classpath
**/.project
**/.settings/
**/.metadata/
**/bin/

# ─── IDE : VS Code ─────────────────────────────────────────────
**/.vscode/
*.code-workspace

# ─── IDE : NetBeans ────────────────────────────────────────────
**/nbproject/private/
**/nbbuild/
**/dist/
**/nbdist/
**/.nb-gradle/

# ─── Logs ──────────────────────────────────────────────────────
**/*.log
**/logs/
*.log.*

# ─── OS ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ─── Build artefacts ───────────────────────────────────────────
**/dist/
**/build/
**/.cache/

# ─── Node.js (si frontend Angular) ─────────────────────────────
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.npm/

# ─── Docker ────────────────────────────────────────────────────
*.pid
*.seed
*.pid.lock

# ─── Test coverage ─────────────────────────────────────────────
**/coverage/
**/.nyc_output/