import groovy.transform.Field

@Field List<String> SERVICE_LIST = ['config-service', 'discovery-service', 'gateway-service', 'resource-service', 'reservation-service']

pipeline {
    agent any

    environment {
        PATH = "/usr/share/maven/bin:${env.PATH}"
        DOCKER_REGISTRY = 'code212'
        VERSION = "${env.BUILD_NUMBER}"
    }

//    triggers {
//        pollSCM('H/5 * * * *')
//    }

    stages {
        stage('📥 Checkout') {
            steps {
                echo '📥 Récupération du code source...'
                checkout scm
                sh 'git log --oneline -3'
            }
        }

        stage('🔨 Build All Services') {
            steps {
                script {
                    for (svc in SERVICE_LIST) {
                        echo "🔨 Building ${svc}..."
                        sh "mvn -f ${svc}/pom.xml clean package -DskipTests"
                    }
                }
            }
        }

        stage('🧪 Test All Services') {
            steps {
                script {
                    for (svc in SERVICE_LIST) {
                        echo "🧪 Testing ${svc}..."
                        sh "mvn -f ${svc}/pom.xml test || true"
                    }
                }
            }
        }

        stage('📊 SonarQube Analysis') {
            steps {
                script {
                    for (svc in SERVICE_LIST) {
                        echo "📊 Analyzing ${svc}..."
                        withSonarQubeEnv('SonarQube') {
                            sh """
                                mvn -f ${svc}/pom.xml \
                                    org.sonarsource.scanner.maven:sonar-maven-plugin:3.10.0.2594:sonar \
                                    -Dsonar.projectKey=code212-${svc} \
                                    -Dsonar.projectName=${svc} || true
                            """
                        }
                    }
                }
            }
        }

        stage('🐳 Docker Build All Services') {
            steps {
                script {
                    for (svc in SERVICE_LIST) {
                        echo "🐳 Building Docker image for ${svc}..."
                        sh """
                            docker build \
                                -t ${DOCKER_REGISTRY}/${svc}:${VERSION} \
                                -t ${DOCKER_REGISTRY}/${svc}:latest \
                                ./${svc} || true
                        """
                    }
                }
            }
        }

        stage('✅ Verify Images') {
            steps {
                sh 'docker images | grep ${DOCKER_REGISTRY} || echo "Aucune image trouvée"'
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline réussi pour TOUS les services !'
        }
        failure {
            echo '❌ Pipeline échoué !'
        }
        always {
            echo '🧹 Nettoyage...'
            deleteDir()
        }
    }
}
