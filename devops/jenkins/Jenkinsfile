import groovy.transform.Field

@Field List<String> SERVICE_LIST = ['config-service', 'discovery-service', 'gateway-service', 'resource-service', 'reservation-service']

pipeline {
    agent any

    environment {
        PATH = "/usr/share/maven/bin:${env.PATH}"
        DOCKER_REGISTRY = 'code212'
        VERSION = "${env.BUILD_NUMBER}"
    }

//    triggers {
//        pollSCM('H/5 * * * *')
//    }

    stages {
        stage('📥 Checkout') {
            steps {
                echo '📥 Récupération du code source...'
                checkout scm
                sh 'git log --oneline -3'
            }
        }

        stage('🔨 Build All Services') {
            steps {
                script {
                    for (svc in SERVICE_LIST) {
                        echo "🔨 Building ${svc}..."
                        sh "mvn -f ${svc}/pom.xml clean package -DskipTests"
                    }
                }
            }
        }

//         stage('🧪 Test All Services') {
//             steps {
//                 script {
//                     for (svc in SERVICE_LIST) {
//                         echo "🧪 Testing ${svc}..."
//                         sh "mvn -f ${svc}/pom.xml test || true"
//                     }
//                 }
//             }
//         }

        stage('Tests unitaires - services métier') {
            steps {
                sh 'mvn -B -ntp -f resource-service/pom.xml -Dtest=ResourceTest,JwtAuthConverterTest org.jacoco:jacoco-maven-plugin:0.8.14:prepare-agent test org.jacoco:jacoco-maven-plugin:0.8.14:report'
                sh 'mvn -B -ntp -f reservation-service/pom.xml -Dtest=ReservationServiceImplTest,JwtAuthConverterTest org.jacoco:jacoco-maven-plugin:0.8.14:prepare-agent test org.jacoco:jacoco-maven-plugin:0.8.14:report'
            }
            post {
                always {
                    junit '*-service/target/surefire-reports/TEST-*.xml'
                }
            }
        }

        stage('📊 SonarQube Analysis') {
            tools {
                jdk 'JDK-21'
            }
            steps {
                script {
                    for (svc in SERVICE_LIST) {
                        echo "📊 Analyzing ${svc}..."
                        dir(svc) {
                            withSonarQubeEnv('SonarQube') {
                                sh """
                                    mvn org.sonarsource.scanner.maven:sonar-maven-plugin:3.10.0.2594:sonar \
                                        -Dsonar.projectKey=code212-${svc} \
                                        -Dsonar.projectName=${svc}
                                """
                            }
                        }
                        echo "Vérification du Quality Gate pour ${svc}"
                        timeout(time: 5, unit: 'MINUTES') {
                            waitForQualityGate abortPipeline: true
                        }
                    }
                }
            }
        }

        stage('🐳 Docker Build All Services') {
            steps {
                script {
                    for (svc in SERVICE_LIST) {
                        echo "🐳 Building Docker image for ${svc}..."
                        sh """
                            docker build \
                                -t ${DOCKER_REGISTRY}/${svc}:${VERSION} \
                                -t ${DOCKER_REGISTRY}/${svc}:latest \
                                ./${svc}
                        """
                    }
                }
            }
        }

        stage('✅ Verify Images') {
            steps {
                script {
                    for (svc in SERVICE_LIST) {
                        def image = "${DOCKER_REGISTRY}/${svc}:${VERSION}"
                        echo "Vérification de l'image ${image}"
                        sh "docker image inspect --format '{{.Id}}' '${image}'"
                    }
                }
            }
        }

        stage('Scan Trivy') {
            steps {
                sh 'mkdir -p trivy-reports'
                script {
                    def findings = []
                    def scanErrors = []
                    for (svc in SERVICE_LIST) {
                        def image = "${DOCKER_REGISTRY}/${svc}:${VERSION}"
                        echo "Scan Trivy de l'image ${image}"
                        def status = sh(returnStatus: true, script: """
                            docker run --rm \
                                -v /var/run/docker.sock:/var/run/docker.sock \
                                -v code212-trivy-cache:/root/.cache/trivy \
                                aquasec/trivy:0.76.2 image --image-src docker \
                                --db-repository public.ecr.aws/aquasecurity/trivy-db:2,mirror.gcr.io/aquasec/trivy-db:2 \
                                --java-db-repository public.ecr.aws/aquasecurity/trivy-java-db:1,mirror.gcr.io/aquasec/trivy-java-db:1 \
                                --scanners vuln --severity HIGH,CRITICAL \
                                --timeout 10m --exit-code 10 --no-progress --format json '${image}' \
                                > 'trivy-reports/${svc}.tmp'
                        """)
                        if (status == 0 || status == 10) {
                            sh "mv 'trivy-reports/${svc}.tmp' 'trivy-reports/${svc}.json'"
                            if (status == 10) {
                                findings.add(svc)
                            }
                        } else {
                            scanErrors.add("${svc} (code ${status})")
                        }
                    }
                    if (findings || scanErrors) {
                        error("Trivy. Vulnérabilités HIGH/CRITICAL : ${findings.join(', ') ?: 'aucune'}. " +
                              "Scans en erreur : ${scanErrors.join(', ') ?: 'aucun'}.")
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-reports/*.json', allowEmptyArchive: true
                }
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline réussi pour TOUS les services !'
        }
        failure {
            echo '❌ Pipeline échoué !'
        }
        always {
            echo '🧹 Nettoyage...'
            deleteDir()
        }
    }
}
